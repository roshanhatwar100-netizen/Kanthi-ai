# KANTHI AI Environment Configuration
# Google Gemini API key (automatically injected in AI Studio)
GEMINI_API_KEY=

# Firebase Configuration (for client and admin server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Configuration (for payment processing in INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server Port
PORT=3000

# Comma-separated Firebase Auth UIDs allowed to access admin routes
ADMIN_UIDS=
